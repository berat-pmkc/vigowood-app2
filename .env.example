# VigoWood Platform - Environment Variables
# Copy this to .env.local and fill in the values

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CRON
CRON_SECRET=your-cron-secret

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VigoWood

# TRENDYOL
TRENDYOL_API_KEY=your-trendyol-api-key
TRENDYOL_API_SECRET=your-trendyol-api-secret
TRENDYOL_SELLER_ID=your-trendyol-seller-id

# IKAS (vigowood.com)
IKAS_CLIENT_ID=your-ikas-client-id
IKAS_CLIENT_SECRET=your-ikas-client-secret
IKAS_STORE_NAME=vigowood

# ANTHROPIC (Ops Center AI Chat)
ANTHROPIC_API_KEY=your-anthropic-api-key

# DİA WEB SERVİS (satış faturaları — her gün 18:10'da otomatik çekilir)
# uyekodu: https://<uyekodu>.ws.dia.com.tr adresindeki alt alan adı
DIA_UYE_KODU=your-dia-uye-kodu
DIA_KULLANICI=your-dia-ws-user
DIA_SIFRE=your-dia-ws-password
# DİA'dan talep edilen API anahtarı (zorunlu değilse boş bırakılabilir)
DIA_API_KEY=
DIA_FIRMA_KODU=1
# 0 = DİA'nın öntanımlı dönemi
DIA_DONEM_KODU=0
