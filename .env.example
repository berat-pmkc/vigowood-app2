# VigoWood Platform - Environment Variables
# Copy this to .env.local and fill in the values

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CRON
CRON_SECRET=your-cron-secret

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VigoWood

# ANTHROPIC (Ops Center AI Chat)
ANTHROPIC_API_KEY=your-anthropic-api-key


# VERİTABANI ŞEMASI
# Ortak Supabase projesinde uygulama public yerine kendi şemasında çalışır
# (ör. vigowood, prova için vigowood_prova). Boş bırakılırsa "public" kullanılır.
# Storage bucket adları da şemaya göre türetilir (<şema>-task-attachments, <şema>-user-avatars).
# NEXT_PUBLIC_SUPABASE_DB_SCHEMA=vigowood

# BAKIM MODU
# "1" olursa tüm istekler /bakim sayfasına yönlenir (giriş gerekmez).
# MAINTENANCE_MODE=1

# Python worker (scripts/task_watcher.py) için şema (varsayılan: public)
# SUPABASE_DB_SCHEMA=vigowood
